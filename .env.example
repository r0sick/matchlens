# Copy this file to .env (never commit .env) and fill in ONE of the two options.

# Option A (recommended): Microsoft Foundry with your Azure sign-in.
#   Project endpoint: Foundry portal > your project > Overview > "Project endpoint"
#   Model: the deployment name under Models + endpoints
#   Then sign in once with the Azure CLI:  az login
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Option B: API key (if you cannot use az login)
#   Endpoint and key: Foundry portal > your project > Overview (Azure OpenAI endpoint + API key)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_MODEL=

# Optional
# MATCHLENS_AI=off                                  # force template texts (no model calls)
# MATCHLENS_MCP_URL=http://127.0.0.1:8000/mcp/     # where the agents find the MatchLens MCP server
